{
  "name": "@sandrinodm/oxlint-config",
  "version": "0.3.0",
  "description": "Strict Oxlint and Oxfmt preset for Vite+: the Cloudflare rules, type-aware checks and custom slop/* rules against low-evidence TypeScript.",
  "keywords": [
    "effect",
    "effect-ts",
    "lint",
    "oxfmt",
    "oxlint",
    "oxlint-config",
    "typescript",
    "vite-plus"
  ],
  "homepage": "https://github.com/sandrinodm/oxlint-config#readme",
  "bugs": "https://github.com/sandrinodm/oxlint-config/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandrinodm/oxlint-config.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "default": "./dist/effect.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "lint:fix": "vp check --fix",
    "prepack": "vp pack",
    "prepare": "vp config",
    "ready": "pnpm check && vp test",
    "test": "vp test",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/oxlint-config": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/tsgo": "^0.73.4",
    "vite-plus": ">=1.7.0"
  },
  "peerDependenciesMeta": {
    "@effect/tsgo": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
